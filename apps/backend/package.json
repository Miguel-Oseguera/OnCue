{
  "name": "backend",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "auth:generate": "auth generate --config src/auth.ts --output src/auth-schema.ts --yes",
    "test": "node --import tsx --test tests/auth.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "@better-auth/expo": "1.7.12",
    "@hono/node-server": "^2.1.3",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "auth": "1.7.12",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}

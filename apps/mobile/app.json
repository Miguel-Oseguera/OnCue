{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.oncue.sierra.dev",
      "infoPlist": {
        "MWDAT": {
          "AppLinkURLScheme": "mobile://",
          "MetaAppID": "0",
          "ClientToken": "",
          "TeamID": "$(DEVELOPMENT_TEAM)"
        },
        "NSBluetoothAlwaysUsageDescription": "OnCue uses Bluetooth to connect to your Meta glasses.",
        "UIBackgroundModes": [
          "bluetooth-central"
        ],
        "NSMicrophoneUsageDescription": "OnCue uses your glasses microphone to recognize capture commands while hands-free mode is enabled."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.2"
          }
        }
      ],
      "./plugins/with-meta-dat.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
